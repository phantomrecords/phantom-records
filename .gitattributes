# Normalize line endings and mark common binaries
* text=auto eol=lf

# Shell / scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Images / binaries
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.svg text
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
*.mp3 binary
*.wav binary
*.flac binary
*.mp4 binary
*.mov binary
